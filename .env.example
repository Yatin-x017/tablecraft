# ─── Supabase (required) ───────────────────────────────────────────────
# From your Supabase project: Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── EmailJS — trial transactional email (client-side, no server secret) ─
# Configured in EmailJS dashboard: Services, Templates, and Account → API Keys
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ─── Resend — production email swap (documented, not built for trial) ──
# Used only if/when the client moves off EmailJS onto Resend + Edge Function
RESEND_API_KEY=

# NOTE: Google OAuth client ID/secret are configured in the Supabase Auth
# dashboard (Authentication → Providers), NOT as app env vars.
